# PulseCart Public Environment Template (Safe Defaults / Placeholders Only)
# Copy to .env or .local/config/*.env for local development

PULSECART_ENV=local
PULSECART_PROFILE=lite

# Service Ports
PULSECART_GATEWAY_PORT=8080
PULSECART_POSTGRES_PORT=5432
PULSECART_REDIS_PORT=6379
PULSECART_KAFKA_PORT=9092

# Database Credentials (Defaults for local development)
POSTGRES_USER=pulsecart
POSTGRES_PASSWORD=pulsecart_dev_password
POSTGRES_DB=pulsecart_catalog

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
